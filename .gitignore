## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options directory
.vs/

# Visual Studio Code
.vscode/

# Rider
.idea/
*.sln.iml

# User secrets and configuration
appsettings.Secrets.json
appsettings.secrets.json

# Environment files
.env
.env.local

# Dependencies
node_modules/

# OS files
.DS_Store
Thumbs.db

# Uploads and submissions
wwwroot/uploads/
wwwroot/submissions/

# Database Files
*.db
*.sqlite
*.sqlite3

# Log Files
*.log

# Configuration Files (local/development)
appsettings.Development.*.json

# SSL/TLS Certificates
*.pfx
*.pem
*.key
*.crt

# Node/NPM
package-lock.json
yarn.lock

# Testing
coverage/
test-results/
.nyc_output/

# Azure
local.settings.json
.azure/

# Temporary/Backup files
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# IDE Local Settings
.vscode/launch.json
.vscode/settings.json
.editorconfig.local

# NuGet
.nuget/

# Database snapshots
*.dbmdl
*.mdb
